<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals"><ProjectGuid>{66666666-6666-4666-8666-666666666666}</ProjectGuid><Keyword>MakeFileProj</Keyword><RootNamespace>VORaytracer</RootNamespace></PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration"><ConfigurationType>Utility</ConfigurationType><PlatformToolset>v145</PlatformToolset><UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries><UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries></PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="$(SolutionDir)config\Common.props" />
  <PropertyGroup><ShaderOutputDir>$(OutDir)Shaders\</ShaderOutputDir><SlangCompiler>$(SlangRoot)\bin\slangc.exe</SlangCompiler><SlangCommon>-target spirv -profile spirv_1_6 -emit-spirv-directly -fvk-use-entrypoint-name</SlangCommon><SlangOptimization Condition="'$(Configuration)'=='Debug'">-O0</SlangOptimization><SlangOptimization Condition="'$(Configuration)'=='Release'">-O3</SlangOptimization></PropertyGroup>
  <ItemGroup>
    <CustomBuild Include="$(SolutionDir)shaders\Vulkan\MeshPipeline.slang">
      <Command>if not exist "$(ShaderOutputDir)" mkdir "$(ShaderOutputDir)"
"$(SlangCompiler)" "%(FullPath)" $(SlangOptimization) -I "$(SolutionDir)shaders\Shared" -target spirv -profile spirv_1_6+spvRayQueryKHR -emit-spirv-directly -fvk-use-entrypoint-name -entry TaskMain -stage amplification -o "$(ShaderOutputDir)Task.spv"
"$(SlangCompiler)" "%(FullPath)" $(SlangOptimization) -I "$(SolutionDir)shaders\Shared" -target spirv -profile spirv_1_6+spvRayQueryKHR -emit-spirv-directly -fvk-use-entrypoint-name -entry MeshMain -stage mesh -o "$(ShaderOutputDir)Mesh.spv"
"$(SlangCompiler)" "%(FullPath)" $(SlangOptimization) -I "$(SolutionDir)shaders\Shared" -target spirv -profile spirv_1_6+spvRayQueryKHR -emit-spirv-directly -fvk-use-entrypoint-name -entry FragmentMain -stage fragment -o "$(ShaderOutputDir)PbrFragment.spv"
"$(SlangCompiler)" "%(FullPath)" $(SlangOptimization) -I "$(SolutionDir)shaders\Shared" -target spirv -profile spirv_1_6+spvRayQueryKHR -emit-spirv-directly -fvk-use-entrypoint-name -entry DenoiserFragmentMain -stage fragment -o "$(ShaderOutputDir)DenoiserPbrFragment.spv"
"$(SlangCompiler)" "%(FullPath)" $(SlangOptimization) -I "$(SolutionDir)shaders\Shared" -target spirv -profile spirv_1_6+spvRayQueryKHR -emit-spirv-directly -fvk-use-entrypoint-name -entry OitFragmentMain -stage fragment -o "$(ShaderOutputDir)OitFragment.spv"
"$(SlangCompiler)" "%(FullPath)" $(SlangOptimization) -I "$(SolutionDir)shaders\Shared" -target spirv -profile spirv_1_6+spvRayQueryKHR -emit-spirv-directly -fvk-use-entrypoint-name -entry OitCompositeFragment -stage fragment -o "$(ShaderOutputDir)OitCompositeFragment.spv"
"$(SlangCompiler)" "%(FullPath)" $(SlangOptimization) -I "$(SolutionDir)shaders\Shared" -target spirv -profile spirv_1_6+spvRayQueryKHR -emit-spirv-directly -fvk-use-entrypoint-name -entry DdgiUpdateMain -stage compute -o "$(ShaderOutputDir)DdgiUpdate.spv"
"$(SlangCompiler)" "%(FullPath)" $(SlangOptimization) -I "$(SolutionDir)shaders\Shared" -target spirv -profile spirv_1_6+spvRayQueryKHR -emit-spirv-directly -fvk-use-entrypoint-name -entry BackgroundVertex -stage vertex -o "$(ShaderOutputDir)BackgroundVertex.spv"
"$(SlangCompiler)" "%(FullPath)" $(SlangOptimization) -I "$(SolutionDir)shaders\Shared" -target spirv -profile spirv_1_6+spvRayQueryKHR -emit-spirv-directly -fvk-use-entrypoint-name -entry BackgroundFragment -stage fragment -o "$(ShaderOutputDir)BackgroundFragment.spv"
"$(SlangCompiler)" "%(FullPath)" $(SlangOptimization) -I "$(SolutionDir)shaders\Shared" -target spirv -profile spirv_1_6+spvRayQueryKHR -emit-spirv-directly -fvk-use-entrypoint-name -entry DenoiserBackgroundFragment -stage fragment -o "$(ShaderOutputDir)DenoiserBackgroundFragment.spv"</Command>
      <Outputs>$(ShaderOutputDir)Task.spv;$(ShaderOutputDir)Mesh.spv;$(ShaderOutputDir)PbrFragment.spv;$(ShaderOutputDir)DenoiserPbrFragment.spv;$(ShaderOutputDir)OitFragment.spv;$(ShaderOutputDir)OitCompositeFragment.spv;$(ShaderOutputDir)DdgiUpdate.spv;$(ShaderOutputDir)BackgroundVertex.spv;$(ShaderOutputDir)BackgroundFragment.spv;$(ShaderOutputDir)DenoiserBackgroundFragment.spv</Outputs>
      <AdditionalInputs>$(SolutionDir)shaders\Shared\Pbr.slang;$(SolutionDir)shaders\Shared\MaterialTypes.slang;$(SolutionDir)shaders\Shared\MaterialSampling.slang;$(SolutionDir)shaders\Shared\Fresnel.slang;$(SolutionDir)shaders\Shared\Microfacet.slang;$(SolutionDir)shaders\Shared\BsdfTypes.slang;$(SolutionDir)shaders\Shared\BsdfDiffuse.slang;$(SolutionDir)shaders\Shared\BsdfConductor.slang;$(SolutionDir)shaders\Shared\BsdfClearcoat.slang;$(SolutionDir)shaders\Shared\BsdfTransmission.slang;$(SolutionDir)shaders\Shared\BsdfAnisotropic.slang;$(SolutionDir)shaders\Shared\BsdfSheen.slang;$(SolutionDir)shaders\Shared\BsdfSubsurface.slang;$(SolutionDir)shaders\Shared\PhaseFunctions.slang</AdditionalInputs>
    </CustomBuild>
    <CustomBuild Include="$(SolutionDir)shaders\Optix\PathTracer.slang">
      <Command>if not exist "$(ShaderOutputDir)" mkdir "$(ShaderOutputDir)"
set "PATH=$(CudaRoot)\bin\x64;%PATH%"
"$(SlangCompiler)" "%(FullPath)" $(SlangOptimization) -I "$(SolutionDir)shaders\Shared" -I "$(OptixRoot)\include" -target ptx -entry RayGen -stage raygeneration -entry ToneMap -stage raygeneration -entry Miss -stage miss -entry ClosestHit -stage closesthit -o "$(ShaderOutputDir)PathTracer.ptx"</Command>
      <Outputs>$(ShaderOutputDir)PathTracer.ptx</Outputs>
      <AdditionalInputs>$(SolutionDir)shaders\Shared\Pbr.slang;$(SolutionDir)shaders\Shared\MaterialTypes.slang;$(SolutionDir)shaders\Shared\MaterialSampling.slang;$(SolutionDir)shaders\Shared\Fresnel.slang;$(SolutionDir)shaders\Shared\Microfacet.slang;$(SolutionDir)shaders\Shared\BsdfTypes.slang;$(SolutionDir)shaders\Shared\BsdfDiffuse.slang;$(SolutionDir)shaders\Shared\BsdfConductor.slang;$(SolutionDir)shaders\Shared\BsdfClearcoat.slang;$(SolutionDir)shaders\Shared\BsdfTransmission.slang;$(SolutionDir)shaders\Shared\BsdfAnisotropic.slang;$(SolutionDir)shaders\Shared\BsdfSheen.slang;$(SolutionDir)shaders\Shared\BsdfSubsurface.slang;$(SolutionDir)shaders\Shared\PhaseFunctions.slang</AdditionalInputs>
    </CustomBuild>
  </ItemGroup>
  <ItemGroup>
    <None Include="$(SolutionDir)shaders\Shared\Pbr.slang" />
    <None Include="$(SolutionDir)shaders\Shared\MaterialTypes.slang" />
    <None Include="$(SolutionDir)shaders\Shared\MaterialSampling.slang" />
    <None Include="$(SolutionDir)shaders\Shared\Fresnel.slang" />
    <None Include="$(SolutionDir)shaders\Shared\Microfacet.slang" />
    <None Include="$(SolutionDir)shaders\Shared\BsdfTypes.slang" />
    <None Include="$(SolutionDir)shaders\Shared\BsdfDiffuse.slang" />
    <None Include="$(SolutionDir)shaders\Shared\BsdfConductor.slang" />
    <None Include="$(SolutionDir)shaders\Shared\BsdfClearcoat.slang" />
    <None Include="$(SolutionDir)shaders\Shared\BsdfTransmission.slang" />
    <None Include="$(SolutionDir)shaders\Shared\BsdfAnisotropic.slang" />
    <None Include="$(SolutionDir)shaders\Shared\BsdfSheen.slang" />
    <None Include="$(SolutionDir)shaders\Shared\BsdfSubsurface.slang" />
    <None Include="$(SolutionDir)shaders\Shared\PhaseFunctions.slang" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
